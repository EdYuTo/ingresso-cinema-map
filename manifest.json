{
  "manifest_version": 3,
  "name": "Ingresso Cinema Map",
  "version": "2.0.0",
  "description": "Mapa de cinemas embutido no ingresso.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Abrir/Fechar Mapa de Cinemas"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://www.ingresso.com/*",
    "https://api-content.ingresso.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://share.google/*",
    "https://maps.app.goo.gl/*",
    "https://goo.gl/*",
    "https://www.google.com/*",
    "https://maps.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ingresso.com/filme/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ingresso.com/filme/*"],
      "js": ["lib/leaflet.js", "inpage.js"],
      "css": ["lib/leaflet.css", "inpage.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
